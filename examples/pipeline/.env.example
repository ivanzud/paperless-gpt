# One file configures the whole pipeline. Copy it to .env and fill in the
# first two sections; the rest has working defaults.

# --- paperless-ngx ----------------------------------------------------------
# Address of paperless-ngx as seen from inside a container. If paperless-ngx
# runs on this machine and publishes port 8000, keep host.docker.internal.
PAPERLESS_URL=http://host.docker.internal:8000
# API token of a paperless-ngx user that may edit documents, tags and
# workflows (paperless-ngx: My Profile -> API Auth Token).
PAPERLESS_TOKEN=
# Optional separate token for paperless-ai, so the audit log shows which tool
# changed what. Empty: PAPERLESS_TOKEN is used for both.
PAPERLESS_AI_TOKEN=
# Address people use to open paperless-ngx in a browser (for links).
PAPERLESS_PUBLIC_URL=http://localhost:8000

# --- models -----------------------------------------------------------------
# "ollama", or "openai" for OpenAI and every OpenAI-compatible server
# (llama.cpp, vLLM, LM Studio, LiteLLM ...).
LLM_BACKEND=ollama
# Used when LLM_BACKEND=ollama
OLLAMA_URL=http://host.docker.internal:11434
# Used when LLM_BACKEND=openai. The URL ends in /v1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
# Model that reads the pages (needs vision) and model that classifies.
VISION_MODEL=
TEXT_MODEL=

# --- optional ---------------------------------------------------------------
# How often paperless-ai looks for new work (cron syntax).
SCAN_INTERVAL=*/5 * * * *
# Language the titles and tags should be in.
OUTPUT_LANGUAGE=English
# The web interfaces are published on this machine only. Use 0.0.0.0 to open
# them to your network; create the paperless-ai account first (see README).
BIND_ADDRESS=127.0.0.1
PAPERLESS_GPT_PORT=8080
PAPERLESS_AI_PORT=3000
PAPERLESS_GPT_IMAGE=ghcr.io/ivanzud/paperless-gpt:latest
PAPERLESS_AI_IMAGE=ghcr.io/ivanzud/paperless-ai:latest
TZ=UTC
